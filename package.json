{
  "name": "phonix-bot",
  "version": "2.1.0",
  "description": "Production Discord music bot with guild session recovery, diagnostics, owner control, and an opt-in Admin Center.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --disable-warning=DEP0040 --disable-warning=DEP0190 --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "start": "node --disable-warning=DEP0040 --disable-warning=DEP0190 --disable-warning=ExperimentalWarning dist/index.js",
    "deploy:commands": "node --disable-warning=DEP0040 --disable-warning=DEP0190 --disable-warning=ExperimentalWarning --import tsx src/scripts/deploy-commands.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=DEP0040 --disable-warning=DEP0190 --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run",
    "test:smoke": "node --disable-warning=DEP0040 --disable-warning=DEP0190 --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run tests/smoke",
    "verify:playback": "node --disable-warning=DEP0040 --disable-warning=DEP0190 --disable-warning=ExperimentalWarning --import tsx src/scripts/verify-playback.ts",
    "verify:dashboard": "node --disable-warning=DEP0040 --disable-warning=DEP0190 --disable-warning=ExperimentalWarning --import tsx src/scripts/verify-dashboard.ts"
  },
  "keywords": [
    "discord-bot",
    "music-bot",
    "typescript",
    "nodejs",
    "discordjs",
    "discord-player",
    "fastify",
    "prisma",
    "sqlite",
    "observability",
    "recovery",
    "oauth2",
    "vitest"
  ],
  "author": "SavioCodes",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SavioCodes/phonix-system.git"
  },
  "bugs": {
    "url": "https://github.com/SavioCodes/phonix-system/issues"
  },
  "homepage": "https://github.com/SavioCodes/phonix-system#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/opus": "^0.10.0",
    "@prisma/client": "^6.9.0",
    "@snazzah/davey": "^0.1.11",
    "@snazzah/davey-wasm32-wasi": "file:vendor/davey-wasm32-wasi",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^2.0.0",
    "discord.js": "^14.26.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.6.1",
    "mediaplex": "^1.0.0",
    "pino": "^10.3.1",
    "youtube-dl-exec": "^3.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "prisma": "^6.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  }
}
